# Copy file này thành .env và điền giá trị. .env đã được gitignore.
# Config chỉ chứa TÊN biến môi trường, không chứa khóa.

# Profile: local | colab | kaggle | api
ARTRAG_PROFILE=local

# Thư mục dữ liệu (raw, kb, images, index, cache)
ARTRAG_DATA_DIR=./data

# API key cho backend LLM qua API
GROQ_API_KEY=
NVIDIA_API_KEY=
